  useStartText: 1
  startText: "\u6575\u306E\u4E2D\u306B\u306F\u30D0\u30EA\u30A2\u3092\u6301\u3064\u7A2E\u65CF\u3082\u5B58\u5728\u3059\u308B\uFF01\u30D0\u30EA\u30A2\u306F\u58CA\u3057\u3066\u3082\u5FA9\u6D3B\u3059\u308B\u305F\u3081\u305F\u304F\u3055\u3093\u5C0F\u7269\u3092\u96C6\u3081\u3066\u5012\u3057\u304D\u308B\u306E\u304C\u30B3\u30C4\uFF01"
