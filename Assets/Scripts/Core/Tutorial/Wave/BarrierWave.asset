  endText: "\u7D20\u6674\u3089\u3057\u3044\uFF01\u3053\u306E\u3088\u3046\u306B\u306A\u308B\u3079\u304F\u305F\u304F\u3055\u3093\u5C0F\u7269\u3092\u96C6\u3081\u3066\u30C9\u30F3\u30C9\u30F3\u6575\u3092\u5012\u3057\u3066\u3044\u3053\u3046\uFF01"
