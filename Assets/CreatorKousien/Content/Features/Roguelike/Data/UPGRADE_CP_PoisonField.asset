  Id: cp_poison
  DisplayName: "\u6BD2\u306E\u8513\u5EF6"
  Description: "\u6575\u3078\u6BD2\u3092\u4ED8\u4E0E\u3057\u305F\u7D2F\u8A08\u5C64\u3092\u8CAF\u3081\u30013\u5C64\u3054\u3068\u306B\u6BD2\u30AD\u30CE\u30B3\u306E\u96E8\u3092\u8D77\u3053\u3059\u3002\u767A\u52D5\u306E\u305F\u3073\u306B\u8155\u304C\u5DE8\u5927\u5316\u3057\u3001\u6BD2\u306E\u51FA\u73FE\u7387\u3082\u4E0A\u304C\u308B\u3002"
  LevelDescriptions:
  - "\u6BD2\u4ED8\u4E0E\u306E\u7D2F\u8A083\u5C64\u3054\u3068\u306B\u6BD2\u30AD\u30CE\u30B32\u500B\u304C\u4E0A\u7A7A\u304B\u3089\u964D\u4E0B\u30024\u79D2\u9593\u3001\u8155\u30B5\u30A4\u30BA\u3068\u6BD2\u306E\u51FA\u73FE\u7387\u3092\u5F37\u5316\u3002"
  - "\u6BD2\u96E8\u304C3\u500B\u306B\u5897\u52A0\u3002\u540C\u3058\u6575\u3078\u306E\u91CD\u306D\u639B\u3051\u3082\u7D2F\u8A08\u3055\u308C\u3001\u4F59\u3063\u305F\u5C64\u306F\u6B21\u306E\u767A\u52D5\u3078\u6301\u3061\u8D8A\u3059\u3002"
  - "\u6BD2\u96E8\u304C4\u500B\u306B\u5897\u52A0\u3002\u6BD2\u72B6\u614B\u306E\u6575\u3092\u5012\u3059\u3068\u6BD2\u30AD\u30CE\u30B34\u500B\u306ETOXIC
    BURST\u304C\u767A\u751F\u3002"
  LevelCardDescriptions:
  - "\u6BD2\u4ED8\u4E0E \u7D2F\u8A083\u5C64\n\u6BD2\u30AD\u30CE\u30B3\xD72\u964D\u4E0B"
  - "\u6BD2\u96E8\xD73\n\u4F59\u5270\u5C64\u3092\u6B21\u3078\u6301\u3061\u8D8A\u3059"
  - "\u6BD2\u96E8\xD74\n\u6BD2\u6575\u6483\u7834\u3067\xD74\u8FFD\u52A0"
