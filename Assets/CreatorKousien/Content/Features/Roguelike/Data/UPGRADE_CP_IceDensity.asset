  - "\u51CD\u7D50\u4ED8\u4E0E\u306E\u7D2F\u8A0810\u5C64\u3054\u3068\u306B\u6C372\u500B\u304C\u4E0A\u7A7A\u304B\u3089\u964D\u4E0B\u30024\u79D2\u9593\u3001\u79FB\u52D5\u901F\u5EA6\u3068\u8155\u30B5\u30A4\u30BA\u3092\u5F37\u5316\u3002"
